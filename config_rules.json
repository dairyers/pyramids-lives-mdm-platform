  "tabs": {
    "INTAKE": "Intake & Gatekeeper",
    "INBOX": "Requests / Approval Inbox",
    "STAGING": "SAP B1 Staging",
    "ANALYTICS": "Regional Analytics",
    "SLA_BOARD": "SLA Board",
    "AUDIT": "Audit Log",
    "ADMIN": "Platform settings"
  },

  "roles": {
    "REQUESTER":          {"label": "Requestor", "tabs": ["INTAKE", "INBOX"], "row_scope": "OWN",
                           "can_submit": ["CUSTOMER", "VENDOR", "ITEM", "COST_CENTER"], "can_decide_states": [], "analytics": "NONE"},
    "MDM_LEAD":           {"label": "MDM Analyst", "tabs": ["INBOX", "STAGING", "ANALYTICS", "SLA_BOARD", "AUDIT"], "row_scope": "ALL",
                           "can_submit": [], "can_decide_states": ["PENDING_MDM"], "analytics": "ACCOUNT_LEVEL"},
    "FINANCE_APPROVER":   {"label": "Finance Manager", "tabs": ["INBOX", "STAGING", "ANALYTICS"], "row_scope": "QUEUE",
                           "can_submit": [], "can_decide_states": ["PENDING_FINANCE"], "analytics": "ACCOUNT_LEVEL"},
    "PAYMENTS_OFFICER":   {"label": "Payments Officer", "tabs": ["INBOX", "STAGING"], "row_scope": "RELEASE",
                           "can_submit": [], "can_decide_states": [], "analytics": "NONE"},
    "REGULATORY_OFFICER": {"label": "Quality / Regulatory Affairs Officer", "tabs": ["INBOX"], "row_scope": "QUEUE",
                           "can_submit": [], "can_decide_states": ["PENDING_REGULATORY"], "analytics": "NONE"},
    "BU_HEAD":            {"label": "Business Unit Head", "tabs": ["INBOX", "ANALYTICS"], "row_scope": "QUEUE",
                           "can_submit": [], "can_decide_states": ["PENDING_BU_HEAD"], "analytics": "AGGREGATE"},
    "BUSINESS_SUPPORT":   {"label": "Business Support Staff", "tabs": ["INBOX"], "row_scope": "QUEUE",
                           "can_submit": [], "can_decide_states": ["PENDING_BUSINESS_SUPPORT"], "analytics": "NONE"},
    "IT_ADMIN":           {"label": "IT / System Administrator", "tabs": ["ADMIN", "SLA_BOARD", "AUDIT"], "row_scope": "META_ONLY",
                           "can_submit": [], "can_decide_states": [], "analytics": "NONE"},
    "SUPERVISOR":         {"label": "Supervisor", "tabs": ["SLA_BOARD", "ANALYTICS"], "row_scope": "META_ONLY",
                           "can_submit": [], "can_decide_states": [], "analytics": "ACCOUNT_LEVEL"},
    "AUDITOR":            {"label": "Internal Auditor", "tabs": ["INBOX", "STAGING", "AUDIT", "ANALYTICS"], "row_scope": "ALL",
                           "can_submit": [], "can_decide_states": [], "analytics": "AGGREGATE"}
  },
  "security": {
    "default_policy": "HIDDEN",
    "always_visible_tabs_in_demo": [],
    "meta_fields": ["request_id", "domain", "sap_table", "record_name", "status", "pending_since", "current_approver_role"],
    "system_fields_visible": ["request_id", "status", "created_at", "pending_since", "last_updated_at", "U_ReqStatus", "U_Requester"],
    "mask_styles": {"last4": {"keep": 4, "mask_char": "*"}, "redact": {"text": "******"}},
    "classes": {
      "GENERAL": {
        "policy_by_role": {"*": "FULL"}
      },
      "FINANCIAL_TERMS": {
        "mask_style": "redact",
        "policy_by_role": {"REQUESTER": "FULL", "MDM_LEAD": "FULL", "FINANCE_APPROVER": "FULL", "BU_HEAD": "FULL", "BUSINESS_SUPPORT": "HIDDEN", "IT_ADMIN": "HIDDEN",
                           "PAYMENTS_OFFICER": "HIDDEN", "REGULATORY_OFFICER": "HIDDEN",
                           "SUPERVISOR": "MASKED", "AUDITOR": "MASKED"}
      },
      "BANK_DETAILS": {
        "mask_style": "last4",
        "write_only_in_form": true,
        "policy_by_role": {"REQUESTER": "MASKED", "MDM_LEAD": "MASKED", "FINANCE_APPROVER": "MASKED",
                           "PAYMENTS_OFFICER": {"policy": "FULL", "only_in_states": ["APPROVED", "SYNCED_TO_SAP"], "otherwise": "MASKED"},
                           "REGULATORY_OFFICER": "HIDDEN", "BU_HEAD": "HIDDEN", "BUSINESS_SUPPORT": "HIDDEN", "IT_ADMIN": "HIDDEN", "SUPERVISOR": "HIDDEN", "AUDITOR": "MASKED"}
      }
    },
    "channel_caps": {
      "EMAIL": {"BANK_DETAILS": "HIDDEN"},
      "APP": {}
    }
  },

  "audit": {
    "log_events": ["ROLE_SWITCHED", "VALIDATION_BLOCKED", "DUPLICATE_FLAGGED", "DUPLICATE_REQUESTER_ANSWER", "DUPLICATE_OVERRIDE_JUSTIFIED", "SUBMITTED", "ROUTED",
                   "APPROVED", "REJECTED", "SYNCED", "SLA_ACTION", "SENSITIVE_FIELD_VIEWED_FULL",
                   "CHECKS_APPROVED", "RELATED_RECORD_REVIEWED", "FORECAST_APPROVED", "FOLLOW_UP_APPROVED", "SETTING_CHANGED"]
  },

  "sla": {
    "watched_states": ["PENDING_FINANCE", "PENDING_REGULATORY", "PENDING_BU_HEAD", "PENDING_BUSINESS_SUPPORT", "PENDING_MDM"],
    "clock": "calendar_hours",
    "system_sender": "mdm-system@livesgroup.com",
    "supervisor_email": "supervisor@livesgroup.com",
    "rules": [
      {"id": "R48", "after_hours": 48, "action": "SEND_HIGH_PRIORITY_EMAIL", "notify": ["current_approver"],
       "subject": "URGENT SLA REMINDER: Request {request_id} pending > 48 hours"},
      {"id": "R96", "after_hours": 96, "action": "CREATE_CALENDAR_INVITE", "notify": ["current_approver", "supervisor"],
       "title": "MDM Bottleneck Review: {request_id}"},
      {"id": "R192", "after_hours": 192, "action": "AUTO_REASSIGN_TO_DELEGATE", "notify": ["delegate", "supervisor"],
       "subject": "Request {request_id} auto-reassigned to delegate after 8 days"}
    ]
  },

  "m365": {
    "card_version": "1.0",
    "originator_id": "REPLACE_WITH_REGISTERED_PROVIDER_GUID",
    "respond_url": "https://mdm.livesgroup.internal/api/v1/approval/respond",
    "digest_roles": ["MDM_LEAD", "FINANCE_APPROVER", "REGULATORY_OFFICER", "BU_HEAD", "BUSINESS_SUPPORT", "SUPERVISOR"]
  },

  "analytics": {
    "product_lines": {"A": "Equipment", "B": "IVD", "C": "Consumable"},
    "noise_filter": {"record_type": "CONFIRMED_PO", "status_in": ["SYNCED_TO_SAP", "COMPLETED"]},
    "approve_roles": ["MDM_LEAD", "FINANCE_APPROVER", "SUPERVISOR"],
    "forecast": {
      "default_model": "seasonal_growth", "lookback_months": 12, "lookback_options": [6, 9, 12],
      "min_points": 6, "horizon_months": 12, "horizon_options": [6, 12], "clip_min": 0,
      "models": ["rolling_avg", "linear_trend", "damped_trend", "seasonal_level", "seasonal_trend", "seasonal_growth", "blend"],
      "comparison_only": ["rolling_avg"],
      "blend_of": ["linear_trend", "damped_trend", "seasonal_level", "seasonal_trend"],
      "labels": {"rolling_avg": "Rolling average", "linear_trend": "Linear trend", "damped_trend": "Damped trend",
                 "seasonal_level": "Seasonal level", "seasonal_trend": "Seasonal trend",
                 "seasonal_growth": "Own season + regional growth", "blend": "Blend of all four"},
      "damped": {"alphas": [0.2, 0.4, 0.6, 0.8], "betas": [0.05, 0.1, 0.2, 0.4], "phis": [0.8, 0.9, 0.95]},
      "seasonal": {"period": 12, "min_pooled_months": 12},
      "seasonal_series": {"harmonics": "auto", "max_harmonics": 3, "min_months_per_number": 3, "fallback_harmonics": 1, "recency_half_life_months": 3, "min_history_months": 12, "growth_share": 1.0}
    },
    "churn": {"recent_window_months": 3, "baseline_window_months": 12, "baseline_precedes_recent": true,
              "velocity_threshold": -0.20, "min_baseline_monthly_volume": 5},
    "cross_sell": {"antecedent_products": ["A", "B"], "consequent_product": "C", "window_days": 90},
    "rolling_backtest": {"origins": 3, "origin_step_months": 3},
    "inventory": {
      "seed": 2026, "simulations": 5000, "horizon_months": 12, "days_per_month": 30.4375,
      "data_source_label": "Sample data (generated): data/regional_orders.csv",
      "sample_warning": "The sample data was generated to match the forecast model's assumptions, so these results are not evidence of real-world performance. Costs, lead times and service levels are assumptions until Lives Group's SAP data replaces them.",
      "upload_warning": "These results come from the file you uploaded. Anything the file does not contain (lead time, costs, service level) is an assumption, tagged as such, and nothing here claims an improvement unless a replay on your history shows one.",
      "ingest": {
        "required": ["date", "country", "product", "quantity", "record_type"],
        "optional": ["on_hand", "stockout_flag", "order_date", "receipt_date", "received_qty", "unit_cost", "price", "salvage",
                     "order_cost", "pack_size", "moq"],
        "unused_for_now": ["on_hand", "stockout_flag", "received_qty"],
        "synonyms": {
          "date": ["date", "docdate", "documentdate", "transactiondate", "requestdate"],
          "country": ["country", "ucountry", "countrycode"],
          "product": ["product", "productline", "uproductline", "item", "itemcode", "sku"],
          "quantity": ["quantity", "qty", "units"],
          "record_type": ["recordtype", "type", "doctype"],
          "on_hand": ["onhand", "stockonhand", "stock"], "stockout_flag": ["stockoutflag", "stockout"],
          "order_date": ["orderdate", "supplierorderdate", "podate"], "receipt_date": ["receiptdate", "receiveddate", "grdate"],
          "received_qty": ["receivedqty", "receivedquantity"], "unit_cost": ["unitcost", "cost", "avgprice"],
          "price": ["price", "unitprice", "sellingprice"], "salvage": ["salvage", "salvagevalue"],
          "order_cost": ["ordercost", "orderingcost"], "pack_size": ["packsize", "pack"], "moq": ["moq", "minimumorder"]},
        "record_types": {
          "purchase_request": ["purchase_request", "purchase request", "purchaserequest", "pr", "request", "requisition", "draft_po", "draft po"],
          "order": ["order", "po", "confirmed_po", "confirmed po", "confirmed", "sales order", "customer order"],
          "mdm_setup": ["mdm_setup", "mdm setup", "master data", "setup", "new customer", "new product", "new item"],
          "other": ["other", "inquiry", "enquiry", "cancelled_po", "cancelled po", "cancelled"]},
        "record_type_labels": {"purchase_request": "Purchase request", "order": "Customer order", "mdm_setup": "MDM setup request", "other": "Other"},
        "basis_type": {"requests": "purchase_request", "orders": "order"},
        "outlier_mad_k": 8.0, "mixed_units_ratio": 1000.0, "min_history_months": 12
      },
      "demand_basis": {
        "default": "requests",
        "sets": {"requests": ["CONFIRMED_USED", "DRAFT_PO"], "orders": ["CONFIRMED_USED"]},
        "labels": {"requests": "Purchase requests (confirmed and draft orders)", "orders": "Confirmed orders only"},
        "why_requests": "Requests are logged before stock limits what can ship, so they sit closer to true demand than shipped orders do.",
        "setup_category": "CONFIRMED_NOT_READY"
      },
      "backtest": {"min_train_months": 12, "min_windows": 6, "min_prior_windows": 4, "borrow_widen": 1.25, "min_ratio": 0.05,
                   "coverage_tolerance": 0.03, "max_inflation": 2.0, "inflation_step": 0.05, "min_bandwidth": 0.02,
                   "fallback_cv": 0.3, "bootstrap_draws": 2000},
      "policy": {"eoq_iterations": 5, "eoq_tolerance": 0.01, "service_levels_shown": [0.90, 0.95, 0.99],
                 "service_level_bounds": [0.5, 0.999], "low_bound_note_months": 1},
      "defaults": {
        "lead_time_months": {"value": 1.0, "unit": "months", "note": "Default: 1 month, fixed. Supplier lead time is not in the data: confirm it."},
        "review_period_months": {"value": 1.0, "unit": "months", "note": "Default: monthly review, because the data is monthly. 0 means continuous review."},
        "service_level": {"value": 0.95, "unit": "share of cycles with no stockout", "note": "Default 95%, unconfirmed."},
        "holding_rate": {"value": 0.20, "unit": "% of unit cost per year", "note": "Default 20%: cost of capital plus storage, insurance and obsolescence. Unconfirmed."},
        "order_cost": {"value": 100.0, "unit": "USD per order", "note": "Placeholder: must confirm. Admin, freight and handling for one supplier order."},
        "salvage": {"value": null, "unit": "USD per unit", "note": "Leave blank unless you know what a leftover unit sells for. Needed to derive a service level from costs."},
        "pack_size": {"value": null, "unit": "units", "note": "Orders must be a multiple of this."},
        "moq": {"value": null, "unit": "units", "note": "Smallest order the supplier accepts."},
        "storage_cap": {"value": null, "unit": "units", "note": "Largest order that fits in storage."},
        "budget_cap": {"value": null, "unit": "USD per order", "note": "Largest cash tied up in one order."},
        "growth_override_pct": {"value": 0.0, "unit": "% per year", "note": "What-if only: extra yearly growth added on top of the forecast."}
      }
    },
    "margin": {"assumed": true, "note": "Assumed gross margin by product line for the prototype. Replace with Finance's figures.",
               "by_product": {"A": 0.22, "B": 0.38, "C": 0.45}},
    "order_pattern": {
      "min_orders": 4, "adi_cutoff": 1.32, "cv2_cutoff": 0.49,
      "labels": {"SMOOTH": "Scheduled: steady size", "ERRATIC": "Scheduled: varying size",
                 "INTERMITTENT": "Ad hoc: steady size", "LUMPY": "Ad hoc: lumpy",
                 "TOO_FEW": "Too few orders to classify"},
      "group_of": {"SMOOTH": "Scheduled", "ERRATIC": "Scheduled", "INTERMITTENT": "Ad hoc", "LUMPY": "Ad hoc",
                   "TOO_FEW": "Too few orders"}
    },
    "regional_view": {
      "window_months": 12,
      "prior_offset_months": 12,
      "growth_definition": "Growth = year-over-year change in confirmed customer purchase-order quantity: (quantity in the current window - quantity in the same months one year earlier) / quantity in the same months one year earlier. Only confirmed orders that passed the noise filter count.",
      "backtest_holdout_months": 6,
      "baseline_windows_months": [6, 12],
      "mock_history_months": 24,
      "country_labels": {"SG": "Singapore", "MY": "Malaysia", "TH": "Thailand", "ID": "Indonesia", "VN": "Vietnam"},
      "request_type_labels": {
        "CONFIRMED_USED": "Confirmed customer orders",
        "CONFIRMED_NOT_READY": "Confirmed orders waiting for setup, or rejected",
        "INQUIRY": "Enquiries",
        "DRAFT_PO": "Draft orders",
        "CANCELLED_PO": "Cancelled orders"
      }
    }
  }
}
